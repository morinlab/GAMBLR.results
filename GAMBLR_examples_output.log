> 
> ## Not run: 
> ##D all_sv = get_manta_sv()
> ##D metadata = get_gambl_metadata()
> ##D missing_samples = dplyr::anti_join(metadata,
> ##D   all_sv,
> ##D   by = c("sample_id" = "tumour_sample_id"))
